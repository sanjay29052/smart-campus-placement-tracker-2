# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ========================================================
# Smart Campus Monitoring System - AWS & Backend Config
# ========================================================

# Flask Application Environment Configuration
FLASK_ENV=production
SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_SECRET_KEY=change_this_to_a_jwt_secure_key

# AWS RDS MySQL Database Connection
MYSQL_HOST=smart-campus-db.xxxxxxxx.us-east-1.rds.amazonaws.com
MYSQL_USER=admin
MYSQL_PASSWORD=your_rds_database_password
MYSQL_DB=smart_campus_db
MYSQL_PORT=3306

# AWS S3 Storage for Grievance Attachments
AWS_ACCESS_KEY_ID=your_aws_iam_access_key
AWS_SECRET_ACCESS_KEY=your_aws_iam_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=smart-campus-attachments-prod
